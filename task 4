        "\n",
        "# TASK 4: Sentiment Analysis\n",
        "# We use TextBlob to classify customer reviews as positive, negative, or neutral\n",
        "\n",
        "from textblob import TextBlob\n",
        "\n",
        "# Sample customer reviews (similar to Amazon or social media comments)\n",
        "reviews = [\n",
        "    'Absolutely love this product! Best purchase I have made this year.',\n",
        "    'Terrible quality. It broke after just two days of use.',\n",
        "    'It is okay, nothing special. Does the job, but packaging was damaged.',\n",
        "    'Amazing customer service and fast delivery. Highly recommended!',\n",
        "    'Worst experience ever. Total waste of money and time.',\n",
        "]\n",
        "\n",
        "print('--- ANALYZING CUSTOMER REVIEWS ---')\n",
        "for i, review in enumerate(reviews, 1):\n",
        "  # Analyze the text\n",
        "  analysis = TextBlob(review)\n",
        "  polarity = analysis.sentiment.polarity\n",
        "\n",
        "  # Classify based on the sentiment score\n",
        "  if polarity > 0:\n",
        "    sentiment = 'Positive 😊'\n",
        "  elif polarity < 0:\n",
        "    sentiment = 'Negative 😞'\n",
        "  else:\n",
        "    sentiment = 'Neutral 😐'\n",
        "\n",
        "  print(f'\\nReview {i}: \"{review}\"')\n",
        "  print(f'-> Classified Sentiment: {sentiment} (Polarity Score: {polarity:.2f})')"
      ]
    }
